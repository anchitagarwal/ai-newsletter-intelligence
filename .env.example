# Copy to .env and fill in values.
# Most credentials live inside n8n — only external tooling goes here.

# GitHub PAT (for pushing this repo)
GITHUB_PAT=

# Anthropic API key (used in call_claude.js via $env.ANTHROPIC_API_KEY if running outside n8n)
# In n8n, use the "Anthropic API" credential instead.
ANTHROPIC_API_KEY=
